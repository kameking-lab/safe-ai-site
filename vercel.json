{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "ignoreCommand": "bash web/scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "automation/storage-gate/*": false
    }
  },
  "crons": [
    {
      "path": "/api/seo/notify-search-console",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/notice-url-health?sample=100",
      "schedule": "0 18 1 * *"
    },
    {
      "path": "/api/cron/signage-jma-health",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/rum-retention",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/search-console-operations",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron/automation-consult-state-probe",
      "schedule": "15 4 1 * *"
    }
  ]
}
