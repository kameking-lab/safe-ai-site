# Public raw archives/dumps are never deployable assets. A reviewed download
# requires an exact allowlist in both deployment and storage-budget policy.
/web/public/**/*.har
/web/public/**/*.trace
/web/public/**/*.log
/web/public/**/*.lcov
/web/public/**/*.jsonl
/web/public/**/*.ndjson
/web/public/**/*.zip
/web/public/**/*.gz
/web/public/**/*.tgz
/web/public/**/*.tar
/web/public/**/*.7z
/web/public/**/*.rar
/web/public/**/*.bz2
/web/public/**/*.xz
/web/public/**/*.zst
/web/public/**/*.sqlite
/web/public/**/*.sqlite3
/web/public/**/*.db
/web/public/**/*.sql
/web/public/**/*.dump
