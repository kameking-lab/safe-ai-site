# Runtime inputs intentionally remain deployable: web/src/data, web/public,
# web/prisma (schema/migrations), and application source.
/.env
/.env.*
!/.env.example
/.vercel/
/.next/
/node_modules/
/web/.vercel/
/web/.next/
/web/node_modules/

# Reproducible build, test, benchmark, cache, and local audit output.
/out/
/build/
/dist/
/coverage/
/test-results/
/test-results-*/
/playwright-report/
/playwright-report-*/
/audit-out/
/.maintenance-snapshots/
/local-snapshots/
/lighthouse-raw/
/lighthouse-raw-*/
/lighthouse-trace/
/lighthouse-trace-*/
/lighthouse-results/
/.lighthouseci/
/.turbo/
/.tmp/
/tmp/
/trace/
/traces/
/videos/
/benchmark-output/
/.benchmark-output/
/.bench/
/.genquality/
/.local-evidence/
/.ci-performance-evidence/
/screenshots/
/logs/

/web/out/
/web/build/
/web/dist/
/web/coverage/
/web/test-results/
/web/test-results-*/
/web/playwright-report/
/web/playwright-report-*/
/web/audit-out/
/web/.maintenance-snapshots/
/web/local-snapshots/
/web/lighthouse-raw/
/web/lighthouse-raw-*/
/web/lighthouse-trace/
/web/lighthouse-trace-*/
/web/lighthouse-results/
/web/.lighthouseci/
/web/.turbo/
/web/.cache/
/web/.tmp/
/web/tmp/
/web/trace/
/web/traces/
/web/videos/
/web/benchmark-output/
/web/.benchmark-output/
/web/.local-evidence/
/web/.ci-performance-evidence/
/web/screenshots/
/web/test-screenshots/
/web/logs/

# Documentation and local tooling are not required by the production runtime.
/docs/audits/
/docs/audits/evidence/
/scripts/
/web/docs/audits/
/web/docs-lighthouse-probe.json
/web/e2e/
/web/e2e-*/
/web/test/
/web/tests/
/web/scripts/*
!/web/scripts/
!/web/scripts/vercel-ignore-build.sh
!/web/scripts/storage-deployment-guard.mjs
!/web/scripts/audit
/web/scripts/audit/*
!/web/scripts/audit/public-identity-guard.mjs
# Vercel CLI resolves this root ignore file against rootDirectory=web.
# Keep the build guards available under either resolution base.
!/scripts/
/scripts/*
!/scripts/vercel-ignore-build.sh
!/scripts/storage-deployment-guard.mjs
!/scripts/audit
/scripts/audit/*
!/scripts/audit/public-identity-guard.mjs
**/__snapshots__/
**/__tests__/
**/*.test.*
**/*.spec.*
playwright*.config.*
vitest*.config.*
lighthouse*.config.*
lh5d-noimg*.json
*.tsbuildinfo
*.log
*.lhr.json
*.tmp
*.trace
Desktop.ini
._*
/.idea/
/.history/

# Public assets are fail-closed. New formats require an explicit reviewed
# allowlist here, in web/.vercelignore, and in storage-budget.yml.
/web/public/**
!/web/public/**/
# Vercel CLI's recursive walker checks directory paths without a trailing slash.
# Keep reviewed public directories traversable while the file extension allowlist stays fail-closed.
!/web/public/geo
!/web/public/icons
!/web/public/images
!/web/public/mascot
!/web/public/safety-images
!/web/public/safety-images/library
!/web/public/safety-images/library/originals
!/web/public/safety-images/library/previews
!/web/public/safety-images/pilot
!/web/public/screenshots
!/web/public/seminars
!/web/public/visual-ky
!/web/public/visual-ky/scenarios
!/web/public/visual-refresh
!/web/public/**/*.ico
!/web/public/**/*.png
!/web/public/**/*.jpg
!/web/public/**/*.jpeg
!/web/public/**/*.gif
!/web/public/**/*.svg
!/web/public/**/*.webp
!/web/public/**/*.avif
!/web/public/**/*.mp4
!/web/public/**/*.webm
!/web/public/**/*.woff
!/web/public/**/*.woff2
!/web/public/**/*.ttf
!/web/public/ads.txt
!/web/public/offline.html
!/web/public/print.css
!/web/public/sw.js
!/web/public/manifest.json
!/web/public/screenshots/manifest.json
!/web/public/geo/japan-prefectures-ne10m.json
!/web/public/seminars/*.pptx
