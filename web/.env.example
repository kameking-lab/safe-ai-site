# ============================================================
# 安全AIポータル — .env.example
# 正式な変数名一覧。命名ガイド: docs/env-naming-guide-2026-05-02.md
# ============================================================

# --- アフィリエイト（ブラウザ公開） ---
# Amazon アソシエイトタグ（例: safeaisite22-22）
NEXT_PUBLIC_AMAZON_AFFILIATE_ID=
# 後方互換のため旧名 NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG も認識します
# 楽天アフィリエイトID（hb.afl.rakuten.co.jp 経由のリダイレクトに使用）
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=

# --- 認証 (NextAuth v5) ---
STRATEGY_AUTH_PASSWORD=
# openssl rand -base64 32 で生成
AUTH_SECRET=
ADMIN_EMAILS=
NEWS_DIGEST_SEND_ENABLED=
# 通知・newsletterの外部配信は明示的にtrueの場合だけ有効（既定OFF）
AUTOMATED_NOTIFICATION_DELIVERY_ENABLED=false
# 当月を YYYY-MM で明示した場合のみ月次ダイジェスト送信を許可
NEWS_DIGEST_PERIOD=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- AI (Gemini) ---
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# https://aistudio.google.com/app/apikey から取得
# ローテーション手順: docs/gemini-rotation-guide.md
GEMINI_API_KEY=
# 本番外部AIの明示的な運用承認フラグ。未設定/falseはAI OFFとして扱う。
GEMINI_EXTERNAL_AI_ENABLED=false

# --- Vercel Blob ストレージ ---
# ローテーション手順: docs/blob-rotation-guide.md
BLOB_READ_WRITE_TOKEN=

# --- メール通知 (Resend) ---
RESEND_FROM_EMAIL=
# Resend ダッシュボード > API Keys で取得
RESEND_API_KEY=
# 送信元アドレス（例: 安全AIポータル <noreply@anzen-ai.com>）
NOTIFY_FROM=
# 気象警報通知用オーディエンスID（notify/subscribe API が使用）
RESEND_AUDIENCE_ID=
# 週間メルマガ専用オーディエンスID（subscribe API が使用）
NEWSLETTER_AUDIENCE_ID=
# 管理画面 API のアクセストークン（未設定時は認証なし）
NEWSLETTER_ADMIN_TOKEN=

# --- Cron ジョブ認証 ---
# openssl rand -hex 32 で生成
CRON_SECRET=

# --- 管理画面 ヘルスチェック認証鍵 ---
# /api/admin/health (JSON) と /admin/health (ページ) の共通シークレット。
# 本番Vercelで強い乱数値を設定（openssl rand -hex 32 で生成）。
# 未設定時は両エンドポイントとも 401 / 404 を返す（安全側フェイル）。
ADMIN_HEALTH_KEY=

# --- Stripe 決済 ---
# 判断基準: docs/stripe-env-decision.md
STRIPE_SECRET_KEY=
# Development: stripe listen で発行される whsec_xxx を使用
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=
NEXT_PUBLIC_STRIPE_PRICE_PRO=

# --- サイト設定 ---
# 本番: https://anzen-ai-portal.jp
NEXT_PUBLIC_SITE_URL=
# Vercel PreviewではVERCEL_ENV=previewにより自動で安全モードになる。
# ローカルのstaging相当検証だけでtrueにし、productionでは設定しない。
SAFE_AI_STAGING_MODE=false
# お問い合わせフォーム (省略可。未設定時はメーラー起動)
INQUIRY_INBOX=
FEEDBACK_INBOX=

# --- 業務自動化・講習・資料作成の相談通知（サーバー専用） ---
# カンマ区切りのメールアドレス。実値は .env.local または本番環境変数だけに設定する。
# 2件を設定し、各受信者へ個別送信する。未設定時は送信成功にせず安全側で停止する。
AUTOMATION_CONSULT_RECIPIENTS=
# 相談専用From。未設定時はNOTIFY_FROMを使用し、両方未設定なら送信しない。
AUTOMATION_CONSULT_FROM=
# 送信元ドメインを配信事業者側で検証した後だけ true。
AUTOMATION_CONSULT_FROM_VERIFIED=false
# bounce/complaint の監視・抑止・停止手順を運用責任者が確認した後だけ true。
AUTOMATION_CONSULT_BOUNCE_COMPLAINT_POLICY_ACK=false
# multi-instanceでのatomic rate limit/idempotency probeに合格した後だけ true。
AUTOMATION_CONSULT_STATE_VERIFIED=false
# sender domain確認と各受信者への限定配送probeに合格した後だけ true。
AUTOMATION_CONSULT_DELIVERY_VERIFIED=false
# 相談本文の保持方針（7〜90日）。メール受付・暗号化queueの双方で明示確認する。
AUTOMATION_CONSULT_RETENTION_DAYS=30
AUTOMATION_CONSULT_RETENTION_POLICY_ACK=false
AUTOMATION_CONSULT_ADMIN_REVIEW_PATH_VERIFIED=false
# provider未設定時の共有Postgres暗号化queue。admin認証・運用担当確認前はfalse。
AUTOMATION_CONSULT_QUEUE_ENABLED=false
AUTOMATION_CONSULT_QUEUE_RETENTION_ACK=false
AUTOMATION_CONSULT_QUEUE_OPERATIONS_OWNER_CONFIGURED=false
AUTOMATION_CONSULT_QUEUE_KEY_VERSION=1
AUTOMATION_CONSULT_QUEUE_ENCRYPTION_SECRET=
# 本番では必須。upstash または既存の server-only Postgres を指定する。
# 未設定・memory指定時は共有rate limit/冪等性を保証できないため503で停止する。
AUTOMATION_CONSULT_STATE_BACKEND=postgres
# Vercel Marketplace / Upstash が発行するサーバー専用値。NEXT_PUBLIC_を付けない。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# postgres指定時は既存のDATABASE_URLを利用し、相談本文・氏名・メール・会社名・生IPは保存しない。
# IPを共有ストアへ送らないためのHMAC秘密値（32文字以上のランダム値）。
AUTOMATION_CONSULT_STATE_HASH_SECRET=

# --- Supabase（任意。未設定時はlocal-only / server保存なし）---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push（3点が揃い、配信flagがtrueの場合だけ有効）---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# 実push配信の明示的な運用承認フラグ。Previewでは値に関係なく停止する。
PUSH_DELIVERY_ENABLED=false

# --- KYサイネージ共有（既定OFF）---
NEXT_PUBLIC_KY_SIGNAGE_SHARING_ENABLED=false
KY_SIGNAGE_SHARING_ENABLED=false

# --- 公開データ取得mode（未設定時はroute既定のfail-closed/fallback）---
NEXT_PUBLIC_API_MODE=
NEXT_PUBLIC_WEATHER_API_MODE=

# --- Google Analytics 4 ---
# GA4測定ID（例: G-XXXXXXXXXX）。未設定時は計測タグを一切出力しない（安全側フェイル）。
# Vercelの VERCEL_ENV=production（本番デプロイ）以外では、この値が設定されていても
# 計測タグは出力されない（Preview/Development分離。src/lib/analytics-env.ts 参照）。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- DB (Prisma / Postgres) ---
# 省略可。未設定時はDB機能が無効
DATABASE_URL=

# --- Google Search Console ---
# Google Search Console でプロパティ登録時に発行されるメタタグの content 値。
# 例: y_-VOPrIGDyyHEdjP0PtPk96E7V5KTh4zdTzhKy9ZBE
# 設定すると <meta name="google-site-verification"> が自動出力される（layout.tsx 参照）。
# 設定手順は HANDOFF_FROM_CURSOR.md「Search Console セットアップ」を参照。
GOOGLE_SITE_VERIFICATION=

# --- 非PII Web Vitals RUM（本番endpoint・DPA承認前はOFF） ---
# ブラウザからは固定の同一origin /api/rum だけを利用し、sinkはサーバー専用。
RUM_COLLECTION_ENABLED=false
# `postgres` は既存の server-only DATABASE_URL を使用する。外部sinkの場合は `external`。
RUM_SINK_BACKEND=postgres
RUM_SINK_ENDPOINT=
RUM_SINK_AUTH_TOKEN=
RUM_RETENTION_DAYS=30
RUM_DPA_APPROVED=false
RUM_EDGE_RATE_LIMIT_VERIFIED=false
# RUM rate limit用の32文字以上のランダムHMAC秘密値。NEXT_PUBLIC_へ入れない。
RUM_RATE_LIMIT_HASH_SECRET=
# 0より大きく1以下。未設定時は0.1（10%）。
RUM_SAMPLE_RATE=0.1

# --- 非PII 自動化相談ファネル（production・明示同意時だけ） ---
# additive migration適用後にtrue。Preview/Developmentではtrueでも収集しない。
AUTOMATION_FUNNEL_COLLECTION_ENABLED=false
# raw保持は1〜30日。完全URL・query・IP・UA・相談入力値は列として持たない。
AUTOMATION_FUNNEL_RETENTION_DAYS=30
# 管理者コックピットに表示する直前のproduction deployment ID（秘密値ではない）。
OPERATIONS_ROLLBACK_DEPLOYMENT_ID=
# 最終gate/smokeの非秘密な運用stamp。値はPASS/FAIL/UNKNOWNとISO日時。
OPERATIONS_LAST_FULL_GATE_STATUS=UNKNOWN
OPERATIONS_LAST_FULL_GATE_AT=
OPERATIONS_LAST_SMOKE_STATUS=UNKNOWN
OPERATIONS_LAST_SMOKE_AT=
OPERATIONS_LAST_SMOKE_DEPLOYMENT_ID=
OPERATIONS_HEALTH_STATUS=unknown
OPERATIONS_DEPLOYMENT_AT=

# Fail-closed until the existing service account has Search Console property access.
SEARCH_CONSOLE_OPERATIONS_ENABLED=false

# --- 機能フラグ ---
# 課金機能フラグ。将来の課金実装時に true に変更
NEXT_PUBLIC_PAID_MODE=false
# 法改正データソース: "sample"(モック) or "real"(実データ)
NEXT_PUBLIC_REVISIONS_INGEST_SOURCE=sample
# 法改正リアルデータURL (real モード時のみ必要)
REVISIONS_REAL_SOURCE_URL=

# --- デバッグ専用 (Development のみ) ---
# NEXT_PUBLIC_FORCE_ERROR=
# NEXT_PUBLIC_FORCE_ERROR_TRANSPORT=
