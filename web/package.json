{
  "name": "web",
  "version": "0.1.1",
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/storage-deployment-guard.mjs --workspace && next build",
    "start": "next start",
    "postinstall": "prisma generate --no-hints || true",
    "lint": "eslint",
    "test": "vitest run",
    "eval:chatbot": "node scripts/chatbot-eval.ts",
    "eval:legal-rag": "node scripts/legal-rag-eval-2026-08-02.mjs",
    "eval:answer-first-conversation": "node scripts/answer-first-conversation-eval.mjs",
    "plain:status": "node scripts/plain-status.ts",
    "plain:test": "vitest run src/lib/plain src/data/plain",
    "curriculum:test": "vitest run src/lib/education-curriculum src/data/education-curriculum src/data/education-decks",
    "curriculum:status": "node scripts/curriculum-status.ts",
    "eval:chatbot-gen": "node scripts/chatbot-eval-phase2.ts",
    "smoke:chatbot-prod": "node scripts/chatbot-prod-smoke-probe.mjs",
    "bench:field-terms": "vitest run src/lib/field-vernacular-bench.test.ts",
    "bench:search-latency": "node scripts/search-latency-bench.mjs",
    "audit:best-in-class": "node scripts/audit/best-in-class-quality-gates.mjs",
    "audit:best-in-class:full": "node scripts/audit/best-in-class-quality-gates.mjs --full",
    "audit:best-in-class:browser": "node scripts/audit/best-in-class-browser-audit.mjs",
    "audit:best-in-class:lighthouse": "node scripts/audit/best-in-class-lighthouse.mjs",
    "audit:performance-budget": "node scripts/audit/performance-budget.mjs",
    "audit:service-first:browser": "node scripts/audit/service-first-browser-audit.mjs",
    "test:service-copy": "vitest run src/lib/audit/service-copy-budget.test.ts",
    "audit:heat-review-pack": "node scripts/audit/heat-review-pack-copy.mjs",
    "audit:heat-review-final": "node scripts/audit/finalize-heat-review-pack.mjs",
    "audit:heat-review-import": "node --experimental-strip-types scripts/audit/validate-heat-review-import.ts",
    "audit:operations-migration-dry-run": "node scripts/audit/operations-growth-migration-dry-run.mjs",
    "audit:gap-closure-migration": "node scripts/audit/japan-leading-gap-closure-migration.mjs --dry-run",
    "audit:operations-live-snapshot": "node scripts/audit/operations-growth-live-snapshot.mjs",
    "audit:production-readiness": "node scripts/audit/final-production-readiness-check.mjs --dry-run",
    "audit:email-dns-readiness": "node scripts/audit/email-dns-readiness-check.mjs --dry-run",
    "smoke:staging:readonly": "node scripts/audit/staging-readonly-smoke.mjs --dry-run",
    "test:e2e": "playwright test",
    "test:e2e:privacy": "playwright test --config=playwright.privacy.config.ts",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:failure": "playwright test --grep @failure",
    "test:e2e:recovery": "playwright test --grep @recovery",
    "test:e2e:ci": "playwright test",
    "test:live": "playwright test",
    "check:ci": "npm run lint && npm run build && npm run test && npm run test:e2e:ci",
    "capture": "node ../scripts/capture-screenshots.mjs",
    "maintenance:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/maintenance/storage-audit.ps1",
    "maintenance:cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/maintenance/cleanup-safe.ps1",
    "maintenance:cleanup:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/maintenance/cleanup-safe.ps1",
    "maintenance:cleanup:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/maintenance/cleanup-safe.ps1 -Apply"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@google-analytics/data": "^5.2.2",
    "@google/genai": "^2.16.0",
    "@prisma/client": "^6.19.3",
    "@stripe/stripe-js": "^9.1.0",
    "@supabase/supabase-js": "^2.106.2",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vercel/blob": "^2.3.3",
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.7.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.30",
    "pdfjs-dist": "6.2.108",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "recharts": "^3.8.1",
    "resend": "^6.18.0",
    "server-only": "0.0.1",
    "stripe": "^22.0.1",
    "web-push": "^3.6.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.0.1",
    "playwright": "1.58.2",
    "prisma": "^6.19.3",
    "read-excel-file": "9.3.4",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  },
  "browserslist": [
    "> 0.3%",
    "not dead",
    "not op_mini all",
    "not ie 11",
    "not safari < 14"
  ],
  "overrides": {
    "brace-expansion": "5.0.9",
    "sharp": "0.35.3",
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "js-yaml": "4.3.1",
    "tar": "^7.5.10",
    "vite": "^8.0.5",
    "minimatch": "^10.2.5",
    "path-to-regexp": "^8.4.2",
    "basic-ftp": "^6.0.1",
    "@vercel/node": {
      "undici": "^6.25.0"
    },
    "@vercel/blob": {
      "undici": "6.28.0"
    },
    "jsdom": {
      "undici": "7.29.0"
    },
    "vercel": {
      "undici": "^6.25.0"
    }
  }
}
