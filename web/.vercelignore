# Runtime inputs intentionally remain deployable: src/data, public,
# prisma (schema/migrations), and application source.
/.env
/.env.*
!/.env.example
/.vercel/
/.next/
/node_modules/

# Reproducible build, test, benchmark, cache, and local audit output.
/out/
/build/
/dist/
/coverage/
/test-results/
/test-results-*/
/playwright-report/
/playwright-report-*/
/audit-out/
/.maintenance-snapshots/
/local-snapshots/
/lighthouse-raw/
/lighthouse-raw-*/
/lighthouse-trace/
/lighthouse-trace-*/
/lighthouse-results/
/.lighthouseci/
/.turbo/
/.cache/
/.tmp/
/tmp/
/trace/
/traces/
/videos/
/benchmark-output/
/.benchmark-output/
/.bench/
/.genquality/
/.local-evidence/
/.ci-performance-evidence/
/screenshots/
/test-screenshots/
/logs/

# Documentation and local tooling are not required by the production runtime.
/docs/audits/
/docs-lighthouse-probe.json
/e2e/
/e2e-*/
/test/
/tests/
/scripts/
**/__snapshots__/
**/__tests__/
**/*.test.*
**/*.spec.*
playwright*.config.*
vitest*.config.*
lighthouse*.config.*
lh5d-noimg*.json
*.tsbuildinfo
*.log
*.lhr.json
*.tmp
*.trace
Desktop.ini
._*
/.idea/
/.history/

# Public raw archives/dumps are never deployable assets. A reviewed download
# requires an exact allowlist in both deployment and storage-budget policy.
/public/**/*.har
/public/**/*.trace
/public/**/*.log
/public/**/*.lcov
/public/**/*.jsonl
/public/**/*.ndjson
/public/**/*.zip
/public/**/*.gz
/public/**/*.tgz
/public/**/*.tar
/public/**/*.7z
/public/**/*.rar
/public/**/*.bz2
/public/**/*.xz
/public/**/*.zst
/public/**/*.sqlite
/public/**/*.sqlite3
/public/**/*.db
/public/**/*.sql
/public/**/*.dump
