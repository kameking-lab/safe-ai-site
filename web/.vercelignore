# Runtime inputs intentionally remain deployable: src/data, public,
# prisma (schema/migrations), and application source.
/.env
/.env.*
!/.env.example
/.vercel/
/.next/
/node_modules/

# Reproducible build, test, benchmark, cache, and local audit output.
/out/
/build/
/dist/
/coverage/
/test-results/
/test-results-*/
/playwright-report/
/playwright-report-*/
/audit-out/
/.maintenance-snapshots/
/local-snapshots/
/lighthouse-raw/
/lighthouse-raw-*/
/lighthouse-trace/
/lighthouse-trace-*/
/lighthouse-results/
/.lighthouseci/
/.turbo/
/.cache/
/.tmp/
/tmp/
/trace/
/traces/
/videos/
/benchmark-output/
/.benchmark-output/
/.bench/
/.genquality/
/.local-evidence/
/.ci-performance-evidence/
/screenshots/
/test-screenshots/
/logs/

# Documentation and local tooling are not required by the production runtime.
/docs/audits/
/docs-lighthouse-probe.json
/e2e/
/e2e-*/
/test/
/tests/
/scripts/*
!/scripts/vercel-ignore-build.sh
!/scripts/storage-deployment-guard.mjs
**/__snapshots__/
**/__tests__/
**/*.test.*
**/*.spec.*
playwright*.config.*
vitest*.config.*
lighthouse*.config.*
lh5d-noimg*.json
*.tsbuildinfo
*.log
*.lhr.json
*.tmp
*.trace
Desktop.ini
._*
/.idea/
/.history/

# Public assets are fail-closed. New formats require an explicit reviewed
# allowlist here, in ../.vercelignore, and in storage-budget.yml.
/public/**
!/public/**/
!/public/**/*.ico
!/public/**/*.png
!/public/**/*.jpg
!/public/**/*.jpeg
!/public/**/*.gif
!/public/**/*.svg
!/public/**/*.webp
!/public/**/*.avif
!/public/**/*.mp4
!/public/**/*.webm
!/public/**/*.woff
!/public/**/*.woff2
!/public/**/*.ttf
!/public/ads.txt
!/public/offline.html
!/public/print.css
!/public/sw.js
!/public/manifest.json
!/public/screenshots/manifest.json
!/public/geo/japan-prefectures-ne10m.json
!/public/seminars/*.pptx
