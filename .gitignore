web/docs/third-party-reviews/scripts/chatbot-prod-smoke-latest.json

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.tmp

# Package manager lock files (npm のみ使用。pnpm/yarn は禁止)
