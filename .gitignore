__pycache__/
*.pyc
.mypy_cache/

# News-feed inter-stage handoff (regenerated each run by fetch-news-feed.mjs)
scripts/etl/data/news-feed-candidates.json

# チャットボット週次スモークプローブ (web/scripts/chatbot-prod-smoke-probe.mjs) の
